{
  "name": "unixpense-svc",
  "version": "1.0.0",
  "description": "An automated expense tracker for (individual) clients of UniCredit BulBank",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npx ts-node src/main.ts",
    "lint": "eslint \"./src/*\" --fix",
    "build": "tsc -p .",
    "start": "node dist/main.js",
    "clean": "tsc --build --clean",
    "up": "docker-compose -f docker-compose.yml --env-file .env.integration up --build --wait",
    "down": "docker-compose -f docker-compose.yml down",
    "test:unit": "jest --testMatch **/src/**/*.test.ts",
    "test:integration": "jest --runInBand --runTestsByPath __tests__/integration/*.test.ts",
    "test:coverage": "jest --runInBand --config jest.coverage.config.js --ci --coverage --coverageReporters=json-summary --coverageReporters=html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikolayrk/unixpense-svc.git"
  },
  "keywords": [
    "unicredit",
    "bulbank",
    "gmail",
    "expense",
    "tracker",
    "budget",
    "budgeting"
  ],
  "author": "Nikolay Kostadinov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nikolayrk/unixpense-svc/issues"
  },
  "homepage": "https://github.com/nikolayrk/unixpense-svc#readme",
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/node": "^20.14.2",
    "@types/sequelize": "^4.28.20",
    "@types/supertest": "^6.0.2",
    "@types/validator": "^13.11.10",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "axios": "^1.7.2",
    "eslint": "^9.4.0",
    "jest": "^29.7.0",
    "nock": "^13.5.4",
    "testcontainers": "^10.9.0",
    "ts-jest": "^29.1.4"
  },
  "dependencies": {
    "@types/express": "^4.17.21",
    "@types/node-fetch": "^2.6.11",
    "@types/seedrandom": "^3.0.8",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "body-parser": "^1.20.2",
    "date-format-parse": "^0.2.7",
    "dotenv": "16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "googleapis": "^140.0.0",
    "inversify": "^6.0.2",
    "mariadb": "3",
    "node-html-parser": "^6.1.13",
    "openapi-types": "^12.1.3",
    "reflect-metadata": "^0.2.2",
    "seedrandom": "^3.0.5",
    "sequelize": "^6.37.3",
    "sequelize-typescript": "^2.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "umzug": "^3.8.1",
    "winston": "^3.13.0",
    "winston-loki": "^6.1.2"
  }
}

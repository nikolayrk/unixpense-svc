{
  "name": "unixpense-svc",
  "version": "1.0.0",
  "description": "An automated expense tracker for (individual) clients of UniCredit BulBank",
  "main": "dist/main.js",
  "scripts": {
    "dev": "npx ts-node src/main.ts",
    "lint": "eslint \"./src/*\" --fix",
    "build": "tsc -p .",
    "start": "node dist/main.js",
    "clean": "tsc --build --clean",
    "up": "docker-compose -f docker-compose.yml --env-file .env.integration up --build --wait",
    "down": "docker-compose -f docker-compose.yml down",
    "test:unit": "jest --testMatch **/src/**/*.test.ts",
    "test:integration": "jest --runInBand --runTestsByPath __tests__/integration/*.test.ts",
    "test:coverage": "jest --runInBand --config jest.coverage.config.js --ci --coverage --coverageReporters=json-summary --coverageReporters=html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikolayrk/unixpense-svc.git"
  },
  "keywords": [
    "unicredit",
    "bulbank",
    "gmail",
    "expense",
    "tracker",
    "budget",
    "budgeting"
  ],
  "author": "Nikolay Kostadinov",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nikolayrk/unixpense-svc/issues"
  },
  "homepage": "https://github.com/nikolayrk/unixpense-svc#readme",
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/node": "^25.2.1",
    "@types/sequelize": "^6.12.0",
    "@types/supertest": "^7.2.0",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.59.0",
    "@typescript-eslint/parser": "^8.59.0",
    "axios": "^1.15.2",
    "eslint": "^10.2.1",
    "jest": "^30.3.0",
    "nock": "^14.0.13",
    "testcontainers": "^11.14.0",
    "ts-jest": "^29.4.9"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/node-fetch": "^2.6.13",
    "@types/seedrandom": "^3.0.8",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "body-parser": "^2.2.2",
    "date-format-parse": "^0.2.7",
    "dotenv": "17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "googleapis": "^171.4.0",
    "inversify": "^8.1.0",
    "mariadb": "3",
    "node-html-parser": "^7.1.0",
    "openapi-types": "^12.1.3",
    "reflect-metadata": "^0.2.2",
    "seedrandom": "^3.0.5",
    "sequelize": "^6.37.8",
    "sequelize-typescript": "^2.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "umzug": "^3.8.2",
    "winston": "^3.19.0",
    "winston-loki": "^6.1.4"
  }
}
